# Copy to .env and fill in. NEVER commit .env.

# --- Anthropic (direct fallback path) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_DIRECT=0                  # 1 = bypass Merge Gateway entirely (the 3 AM escape hatch)

# --- Merge Gateway: CRITICAL PATH. $20 credit, code CORGI-CAFE ---
MERGE_GATEWAY_BASE_URL=
MERGE_GATEWAY_API_KEY=

# --- Merge Unified API: enrichment only (Drive EXIF, Notion) ---
MERGE_API_KEY=
MERGE_ACCOUNT_TOKEN=

# --- Google: Gmail + Calendar (OAuth test-user mode) + Places ---
GOOGLE_CLIENT_SECRETS=./client_secret.json
GOOGLE_TOKEN_PATH=./.google_token.json
GOOGLE_PLACES_API_KEY=

# --- Photon: $25 credit, code Hackwithphoton, app.photon.codes/sign-in ---
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=
PHOTON_FROM_NUMBER=

# --- App ---
PALATE_DB=./palate.db
HOME_CITY=San Francisco
